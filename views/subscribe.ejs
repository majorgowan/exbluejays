<!DOCTYPE html>
<html lang="en">

<%- include('partials/header.ejs') %>

<body>
<div class="exjayform">
    <% if (method === "get") { %>
        <h4 class="exjayheading">Subscribe to the Ex-Blue Jay Report</h4><BR>
        <form method="POST" action="/subscribe">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <label for="email_address">Please enter your email address:</label>
            <input type="email" id="email_address" name="email_address"
                   autocomplete="email" required>
            <button type="submit">Submit</button>
        </form>
    <% } else { %>
        <p><%= message %></p>
        <p>If you don't receive your ex-Blue Jays report, please check your spam bzw. junk folder.</p>
    <% } %>
</div>
<p>
    By subscribing you are consenting to the <a href="/privacy">privacy policy</a>. You may unsubscribe at any time.
</p>
</body>

</html>
