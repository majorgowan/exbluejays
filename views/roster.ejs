<!DOCTYPE html>
<html lang="en">

<%- include("partials/head.ejs") %>

<body>

<%- include("partials/header.ejs") %>

<div>
    <table class="sortable">
        <thead>
        <tr>
            <th>Name</th>
            <th>Position</th>
            <th>Current Team</th>
            <th>Years with Jays</th>
        </tr>
        </thead>
        <tbody>
        <%- players.map(player => `<tr><td>${player.fullName}</td>
                                       <td>${player.position}</td>
                                       <td>${player.latest_team}</td>
                                       <td>${player.years_with_jays.join(",")}</td></tr>`).join('') %>
        </tbody>
    </table>
</div>
</body>

<%- include('partials/footer.ejs') %>

</html>
