<div>
    <table class="exjayseries">
        <thead>
            <th></th>
            <th></th>
            <th class="left-th">ex-Bats</th>
            <th class="left-th">ex-Arms</th>
        </thead>
        <% for (series of Object.keys(schedule)) { %>
            <tr>
                <td class="exjayseriesdate">
                    <span>
                        <%= schedule[series].from_date %> - <%= schedule[series].to_date %>
                    </span>
                </td>
                <td>
                    <span class="exjayseriesopponent"><%= schedule[series].phrase %> <b><%= schedule[series].opponent %></b></span>
                </td>
                <td>
                    <% for (exBat of schedule[series].exBats) { %>
                        <span class="exjayname"><%= exBat %></span><BR>
                    <% } %>
                </td>
                <td>
                    <% for (exArm of schedule[series].exArms) { %>
                        <span class="exjayname"><%= exArm %></span><BR>
                    <% } %>
                </td>
            </tr>
        <% } %>
    </table>
</div>
