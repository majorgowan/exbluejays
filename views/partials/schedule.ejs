<div>
    <table class="exjayseries">
        <thead>
            <th></th>
            <th></th>
            <th class="left-th">ex-Blue Jays</th>
        </thead>
        <% for (series of Object.keys(schedule)) { %>
            <tr>
                <td class="exjayseriesdate">
                    <span><%= schedule[series].from_date %></span>
                    -
                    <span><%= schedule[series].to_date %></span>
                </td>
                <td>
                    <span class="exjayseriesopponent"><%= schedule[series].phrase %> <span class="exjayseriesopponentteam"><%= schedule[series].opponent %></span></span>
                </td>
                <td class="exjayseriesplayercolumn">
                    <% for (exBat of schedule[series].exBats) { %>
                        <span class="exjayseriesname"><%= exBat %></span>&emsp;
                    <% } %>
                    <% for (exArm of schedule[series].exArms) { %>
                        <span class="exjayseriesname"><%= exArm %></span>&emsp;
                    <% } %>
                </td>
            </tr>
        <% } %>
    </table>
</div>
