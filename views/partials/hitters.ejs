<div class="exjaytablediv">
    <table class="sortable exjaytable <%= table_class %>">
        <thead>
        <tr>
            <th>Name</th>
            <th></th>
            <th>Position</th>
            <th title="Games Played as Blue Jay">JGP</th>
            <th title="Last Year with Blue Jays">Ex since</th>
            <th title="Games Played">GP</th>
            <th title="At Bats">AB</th>
            <th title="Hits">H</th>
            <th title="Bases on Balls">BB</th>
            <th title="Home Runs">HR</th>
            <th title="Runs Batted In">RBI</th>
            <th title="Batting Average">AVG</th>
            <th title="On-Base Average">OBP</th>
            <th title="Slugging Average">SLG</th>
            <th title="OBP plus Slugging">OPS</th>
            <th title="Runs Created">RC</th>
        </tr>
        </thead>
        <tbody>
        <%- hitters.map(player => `<tr><td><a class="exjayplayerlink" href="${players_url}/${player._id}" target="_blank" rel="noopener noreferrer">${player.name}</a></td>
                                       <td><i class="logo bbclub-${teamAbbMap[player.team]}" title="${player.team}"></i></td>
                                       <td>${player.position}</td>
                                       <td>${player.gamesWithJays}</td>
                                       <td title="Seasons with Jays: ${player.yearsWithJays}">${player.ex_since}</td>
                                       <td class="tstat">${player.gamesPlayed}</td>
                                       <td class="tstat">${player.atBats}</td>
                                       <td class="tstat">${player.hits}</td>
                                       <td class="tstat">${player.baseOnBalls}</td>
                                       <td class="tstat">${player.homeRuns}</td>
                                       <td class="tstat">${player.rbi}</td>
                                       <td class="tstat">${player.avg}</td>
                                       <td class="tstat">${player.obp}</td>
                                       <td class="tstat">${player.slg}</td>
                                       <td class="tstat">${player.ops}</td>
                                       <td class="tstat">${player.runsCreated.toFixed(1)}</td>
                                       </tr>`).join('') %>
        </tbody>
    </table>
</div>
