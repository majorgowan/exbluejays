<div>
    <h3 class="exjayheading">
        The Ex Bats
    </h3>
    <table class="sortable">
        <thead>
        <tr>
            <th>Name</th>
            <th></th>
            <th>Position</th>
            <th>Ex since</th>
            <th>GP</th>
            <th>AB</th>
            <th>H</th>
            <th>BB</th>
            <th>HR</th>
            <th>RBI</th>
            <th>AVG</th>
            <th>OBP</th>
            <th>SLG</th>
            <th>OPS</th>
        </tr>
        </thead>
        <tbody>
        <%- hitters.map(player => `<tr><td>${player.name}</i></td>
                                       <td><i class="logo bbclub-${teamAbbMap[player.team]}" title="${player.team}"></i></td>
                                       <td>${player.position}</td>
                                       <td>${player.ex_since}</td>
                                       <td class="tstat">${player.gamesPlayed}</td>
                                       <td class="tstat">${player.atBats}</td>
                                       <td class="tstat">${player.hits}</td>
                                       <td class="tstat">${player.baseOnBalls}</td>
                                       <td class="tstat">${player.homeRuns}</td>
                                       <td class="tstat">${player.rbi}</td>
                                       <td class="tstat">${player.avg}</td>
                                       <td class="tstat">${player.obp}</td>
                                       <td class="tstat">${player.slg}</td>
                                       <td class="tstat">${player.ops}</td>
                                       </tr>`).join('') %>
        </tbody>
    </table>
</div>
