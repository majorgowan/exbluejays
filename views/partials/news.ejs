<div class="exjaynews">
    <ul>
        <% for (newsItem of news) { %>
            <li class="exjaynewsitem <%= newsItem.categoryClass %>">
                <span class="exjaynewsdate"><%= newsItem.shortDate %>:</span>
                <span class="exjaynewstitle">
                <a title="<%= newsItem.title %>" target="_blank" href="<%= newsItem.url %>"><%= newsItem.shortTitle %></a>
                </span>
                <span class="exjaynewsname"><%= newsItem.playerName %></span>
            </li>
        <% } %>
    </ul>
</div>
