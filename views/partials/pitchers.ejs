<div>
    <table class="sortable exjaytable <%= table_class %>">
        <thead>
        <tr>
            <th>Name</th>
            <th></th>
            <th title="Games Played as Blue Jay">JGP</th>
            <th title="Last Year with Blue Jays">Ex since</th>
            <th title="Games Played">GP</th>
            <th title="Games Started">GS</th>
            <th title="Innings Pitched">IP</th>
            <th title="Wins">W</th>
            <th title="Losses">L</th>
            <th title="Earned Run Average">ERA</th>
            <th title="Strikeouts">K</th>
            <th title="Bases on Balls Allowed">BB</th>
            <th title="Home Runs Allowed">HR</th>
            <th title="Walks plus Hits per Innings Pitched">WHIP</th>
            <th title="Saves">S</th>
            <th title="Holds">HLD</th>
            <th title="Runs Prevented">RP</th>
        </tr>
        </thead>
        <tbody>
        <%- pitchers.map(player => `<tr><td><a class="exjayplayerlink" href="${players_url}/${player._id}" target="_blank" rel="noopener noreferrer">${player.name}</a></td>
                                            <td><i class="logo bbclub-${teamAbbMap[player.team]}" title="${player.team}"></i></td>
                                            <td>${player.gamesWithJays}</td>
                                            <td>${player.ex_since}</td>
                                            <td class="tstat">${player.gamesPitched}</td>
                                            <td class="tstat">${player.gamesStarted}</td>
                                            <td class="tstat">${player.inningsPitched}</td>
                                            <td class="tstat">${player.wins}</td>
                                            <td class="tstat">${player.losses}</td>
                                            <td class="tstat">${player.era}</td>
                                            <td class="tstat">${player.strikeOuts}</td>
                                            <td class="tstat">${player.baseOnBalls}</td>
                                            <td class="tstat">${player.homeRuns}</td>
                                            <td class="tstat">${player.whip}</td>
                                            <td class="tstat">${player.saves}</td>
                                            <td class="tstat">${player.holds}</td>
                                            <td class="tstat">${player.runsPrevented.toFixed(1)}</td>
                                            </tr>`).join('') %>
        </tbody>
    </table>
</div>
