<!DOCTYPE html>
<html lang="en">

<%- include("partials/header.ejs") %>

<body>
<h2 class="exjayheading">Your report for Week Ending <%= endDateString %></h2>

<% if (locals.summary) { %>
    <%- include("partials/summary.ejs") %>
<% } %>

<p>
    Check out the <a href="https://exbluejays.ca/report?endDate=<%= endDate %>">full report</a>.
</p>

<h3 class="exjayheading">
    Stats Corner
</h3>

<h4 class="exjayheading">
    Your top Ex Bats of the week
</h4>
<%- include("partials/hitters.ejs", { hitters: hitters_week, table_class: "showtable" }) %>

<h4 class="exjayheading">
    ... and of the season so far
</h4>
<%- include("partials/hitters.ejs", { hitters: hitters_ytd, table_class: "showtable" }) %>

<BR>

<h4 class="exjayheading">
    Your top Ex Arms of the week
</h4>
<%- include("partials/pitchers.ejs", { pitchers: pitchers_week, table_class: "showtable" }) %>

<h4 class="exjayheading">
    ... and of the season so far
</h4>
<%- include("partials/pitchers.ejs", { pitchers: pitchers_ytd, table_class: "showtable" }) %>

<% if (locals.news && locals.news.length > 0) { %>
    <h3 class="exjayheading">
        News Roundup
    </h3>
    <%- include("partials/news.ejs") %>
<% } %>

<% if (locals.schedule) { %>
    <h3 class="exjayheading">
        Blue Jays opponents this week
    </h3>
    <%- include("partials/schedule.ejs") %>
<% } %>

<p>
    This email was sent to <%= email %>.
    <a href="<%= unsubscribe_url %>">Unsubscribe</a> from the Ex-Blue Jays Report.
</p>

</body>

<%- include("partials/footer.ejs", { email: true }) %>

</html>