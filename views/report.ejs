<!DOCTYPE html>
<html lang="en">

<%- include("partials/header.ejs") %>

<body>
<div class="dateselectdiv">
    <h3 class="exjayheading">Report for Week Ending <%= endDateString %></h3>
    <!-- <label for="dateSelect">Choose a Week:</label> -->
    <select class="exjayselect" id="dateSelect" name="dateSelect"
            onchange="changeEndDate()">
        <option value="" disabled selected>Select Week</option>
        <% endDates.forEach(date => { %>
            <option value="<%= date %>"><%= date %></option>
        <% }); %>
    </select>
    <span>
        <input class="exjaycheckbox" id="ytdCheckbox" type="checkbox"
               name="ytdCheckbox"
               <%= ytd ? "checked" : "" %>
               onchange="changeYTD()">
        <label class="exjaycheckbox" for="ytdCheckbox">YTD</label>
    </span>
</div>

<h3 class="exjayheading">
    The Ex Bats
</h3>
<%- include("partials/hitters.ejs") %>

<h3 class="exjayheading">
    The Ex Arms
</h3>
<%- include("partials/pitchers.ejs") %>

<% if (locals.schedule) { %>
    <h3 class="exjayheading">
        Blue Jays opponents this week
    </h3>
    <%- include("partials/schedule.ejs") %>
<% } %>

<%- include("partials/subscribe_link.ejs") %>

</body>

<%- include("partials/footer.ejs") %>

</html>
