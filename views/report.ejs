<!DOCTYPE html>
<html lang="en">

<!-- TODO: mobile friendly version
           with panning tables with sticky headings etc.
           also index page -->

<%- include("partials/header.ejs") %>

<body>
<div class="dateselectdiv">
    <h3 class="exjayheading">Report for Week Ending <%= endDateString %></h3>
    <!-- <label for="dateSelect">Choose a Week:</label> -->
    <select class="exjayselect" id="dateSelect" name="dateSelect"
            onchange="changeEndDate()">
        <option value="" disabled selected>Select Week</option>
        <% endDates.forEach(date => { %>
            <option value="<%= date.endDate %>"><%= date.endDateString %></option>
        <% }); %>
    </select>
</div>

<% if (locals.summary) { %>
    <%- include("partials/summary.ejs") %>
<% } %>

<div class="radiodiv">
    <h3 class="exjayheading">
        Stats Corner
    </h3>

    &emsp; &emsp;

    <div class="exjayradiopanel">
        <div>
            <input class="exjayradio" id="weekRadio" type="radio" value="week"
                   name="exjayradio" checked onchange="changeYTD()">
            <label class="exjayradio" for="weekRadio">Past week</label>
        </div>

        <div>
            <input class="exjayradio" id="ytdRadio" type="radio" value="ytd"
                   name="exjayradio" onchange="changeYTD()">
            <label class="exjayradio" for="ytdRadio">Year-to-date</label>
        </div>
    </div>
</div>
<h4 class="exjayheading">
    The Ex Bats
</h4>
<%- include("partials/hitters.ejs", { hitters: hitters_week, table_class: "showtable" }) %>
<%- include("partials/hitters.ejs", { hitters: hitters_ytd, table_class: "hidetable" }) %>

<h4 class="exjayheading">
    The Ex Arms
</h4>
<%- include("partials/pitchers.ejs", { pitchers: pitchers_week, table_class: "showtable" } ) %>
<%- include("partials/pitchers.ejs", { pitchers: pitchers_ytd, table_class: "hidetable" } ) %>

<% if (locals.news && locals.news.length > 0) { %>
    <h3 class="exjayheading">
        News Roundup
    </h3>
    <%- include("partials/news.ejs") %>
<% } %>

<% if (locals.schedule) { %>
    <h3 class="exjayheading">
        Blue Jays opponents this week
    </h3>
    <%- include("partials/schedule.ejs") %>
<% } %>

<%- include("partials/subscribe_link.ejs") %>

</body>

<%- include("partials/footer.ejs") %>

</html>
